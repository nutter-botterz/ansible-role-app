# .ansible-lint configuration
# https://ansible-lint.readthedocs.io/en/latest/

# Skip specific rules
skip_list:
  - yaml
  - name[casing]
  - name[prefix]
  - role-name

# Exclude paths
exclude_paths:
  - .github/workflows/
  - molecule/
  - tests/
  - venv/
  - .venv/

# Use specific profile
profile: min
