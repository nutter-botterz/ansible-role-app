# .ansible-lint configuration
# https://ansible-lint.readthedocs.io/en/latest/

# Skip specific rules
skip_list:
  - yaml  # Disable YAML syntax checking
  - name[casing]
  - name[prefix]

# Exclude paths
exclude_paths:
  - .github/workflows/
  - molecule/
  - tests/
  - venv/
  - .venv/

# Use specific profile
profile: minimal
