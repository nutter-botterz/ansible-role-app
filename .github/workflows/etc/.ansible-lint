# .ansible-lint configuration
# https://ansible-lint.readthedocs.io/en/latest/

# Skip specific rules
skip_list:
  - yaml  # Disable YAML syntax checking (use standard YAML linter instead)
  - name[casing]  # Allow any casing for name
  - name[prefix]  # Allow any prefix

# Exclude paths
exclude_paths:
  - .github/workflows/
  - molecule/
  - tests/
  - venv/
  - .venv/

# Mock modules or roles
mock_modules:
  - community.docker.docker_container
  - community.docker.docker_image

# Mock roles
mock_roles: []

# Define tags to run (default runs all)
# tags:
#   - tasks
#   - handlers
#   - variables
#   - meta

# Use specific profile
# https://ansible-lint.readthedocs.io/en/latest/profiles/
profile: minimal

# Regex for valid role names
role_name:
  # Allow these patterns (default)
  # The pattern must match the role directory name
  pattern: '^[a-z][a-z0-9_]+$'

  # Whether to use case-sensitivity (default: true)
  case_sensitive: false
