{
  "branches": [
    "main",
    {
      "name": "fix/*",
      "prerelease": true
    },
    {
      "name": "feature/*",
      "prerelease": true
    }
  ],
  "tagFormat": "{{branch}}.{{version}}",
  "pluginConfig": {
    "@semantic-release/github": {
      "releaseNotes": false
    }
  },
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator"
  ],
  "preset": "conventionalcommits"
}
